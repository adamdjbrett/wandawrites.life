---
layout: page.njk
---

<p><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time></p>
{{ content | safe }}
{% if categories and categories.length %}
<p>
  Categories:
  {% for category in categories %}
    <span>{{ category }}</span>{% if not loop.last %}, {% endif %}
  {% endfor %}
</p>
{% endif %}
