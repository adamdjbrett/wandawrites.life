---
layout: page.njk
title: Blog
pagination:
  data: collections.post
  size: 5
  reverse: true
  alias: posts
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

<ul>
{% for post in posts %}
  <li>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p><time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
    <p>{{ post.content | striptags | truncate(240, true, "...") }}</p>
  </li>
{% endfor %}
</ul>

<nav aria-label="Pagination">
  {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">&larr; Newer</a>{% endif %}
  <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Older &rarr;</a>{% endif %}
</nav>
